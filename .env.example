# Copy to `.env` (gitignored) and edit. Placeholder values only: never commit real ones.
# Everything is optional. Variables set in your shell take precedence over this file.

# --- Read by the code today -------------------------------------------------------------

# Port for `npm run dev` and `npm run serve`. Default 5274.
# PORT=5274

# Address `npm run serve` binds to. Default 127.0.0.1 (this machine only).
# BOT_CROSSING_HOST=127.0.0.1

# Folder that holds colony.json. Default ./data
# BOT_CROSSING_DATA=/path/to/data

# Where each harness keeps its sessions, if not in the default place.
# CODEX_HOME=/path/to/.codex
# BOT_CROSSING_CURSOR_PROJECTS=/path/to/.cursor/projects

# --- Planned integrations: NOT IMPLEMENTED ----------------------------------------------
# Nothing reads these yet. Names are provisional and may change when the code is written.
# Credentials for them will belong here or in a gitignored file, never in the repository.

# Email
# EMAIL_IMAP_HOST=imap.example.com
# EMAIL_IMAP_USER=you@example.com
# EMAIL_IMAP_PASSWORD=changeme

# Google Drive
# GOOGLE_DRIVE_CREDENTIALS_FILE=/path/to/credentials.json

# Jellyfin
# JELLYFIN_URL=http://jellyfin.example.com:8096
# JELLYFIN_API_KEY=changeme

# Jarvis (local agent system)
# JARVIS_URL=http://jarvis.example.com:8000
# JARVIS_API_KEY=changeme

# Extra monitoring endpoints
# MONITORING_URL=http://monitoring.example.com:9090
