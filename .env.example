# Copy to `.env` (gitignored) and edit. Placeholder values only: never commit real ones.
# Everything is optional. Variables set in your shell take precedence over this file.

# --- Server -------------------------------------------------------------------------------

# Port for `npm run dev` and `npm run serve`. Default 5274.
# PORT=5274

# Address `npm run serve` binds to. Default 127.0.0.1 (this machine only).
# BOT_CROSSING_HOST=127.0.0.1

# Folder for local state: colony.json, the Google token, the HTTP checks file. Default ./data
# BOT_CROSSING_DATA=/path/to/data

# Where each harness keeps its sessions, if not in the default place.
# CODEX_HOME=/path/to/.codex
# BOT_CROSSING_CURSOR_PROJECTS=/path/to/.cursor/projects

# --- Connectors ---------------------------------------------------------------------------
# All off by default. List the ones you want, comma separated:
#   system, email, drive, jellyfin, http
# HOMEBASE_CONNECTORS=system

# system: this machine. Percentages at which a reading needs attention (default 90).
# SYSTEM_CPU_WARN=90
# SYSTEM_MEM_WARN=90
# SYSTEM_DISK_WARN=90
# SYSTEM_GPU_WARN=90

# email and drive: your own Google OAuth client ("Desktop app" type), then `npm run google-auth`.
# The refresh token is stored in the data folder, never here.
# GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=changeme
# GOOGLE_TOKEN_FILE=/path/to/google-token.json
# EMAIL_MAX_ITEMS=5
# EMAIL_UNREAD_WARN=50
# DRIVE_MAX_ITEMS=5
# DRIVE_SHARED_ATTENTION_HOURS=24

# jellyfin: server address and an API key created in its dashboard.
# JELLYFIN_URL=http://jellyfin.example.com:8096
# JELLYFIN_API_KEY=changeme
# JELLYFIN_MAX_ITEMS=5

# http: generic status checks for your own services. The list of checks is a local file;
# copy http-checks.example.json to data/http-checks.json and edit it.
# HTTP_CHECKS_FILE=/path/to/http-checks.json
# A check with "tokenEnv": "EXAMPLE_AGENT_TOKEN" sends this value as a Bearer token.
# EXAMPLE_AGENT_TOKEN=changeme
